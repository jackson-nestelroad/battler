{
  "excludeTags": [
    "mon",
    "of",
    "player",
    "side",
    "slot",
    "position",
    "source",
    "gender",
    "health",
    "level",
    "name",
    "species",
    "stats",
    "stat",
    "by",
    "exp",
    "atk",
    "def",
    "spa",
    "spd",
    "spe",
    "hp",
    "target",
    "anim",
    "newmove",
    "pick",
    "size",
    "length",
    "id",
    "time",
    "tera",
    "into_position"
  ],
  "keepSpecificTags": [
    "from",
    "ability",
    "item",
    "move",
    "effect",
    "condition",
    "weather",
    "status",
    "volatile"
  ],
  "injectDimensions": [
    { "match": { "title": "crit" }, "inject": ["battletype:singles"] },
    { "match": { "title": "supereffective" }, "inject": ["battletype:singles"] },
    { "match": { "title": "resisted" }, "inject": ["battletype:singles"] }
  ],
  "collapseDimensions": [
    { "match": { "title": "abilitystart" }, "collapse": ["ability"] },
    { "match": { "title": "itemstart" }, "collapse": ["item"] },
    { "match": { "title": "abilityend" }, "collapse": ["ability"] },
    { "match": { "title": "addvolatile" }, "collapse": ["volatile"] },
    { "match": { "title": "block" }, "collapse": ["ability", "move", "item"] },
    { "match": { "title": "catch" }, "collapse": ["item"] },
    { "match": { "title": "catchfailed" }, "collapse": ["item"] },
    { "match": { "title": "deductpp" }, "collapse": ["move"] },
    { "match": { "title": "didnotlearnmove" }, "collapse": ["move"] },
    { "match": { "title": "item" }, "collapse": ["item"] },
    { "match": { "title": "itemend" }, "collapse": ["item"] },
    { "match": { "title": "learnedmove" }, "collapse": ["move"] },
    { "match": { "title": "removevolatile" }, "collapse": ["volatile"] },
    { "match": { "title": "restorepp" }, "collapse": ["move"] },
    { "match": { "title": "setpp" }, "collapse": ["move"] },
    { "match": { "title": "swapsidecondition" }, "collapse": ["move", "condition"] },
    { "match": { "title": "activate", "ability": "Forewarn" }, "collapse": ["move"] }
  ]
}
