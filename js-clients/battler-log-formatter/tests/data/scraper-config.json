{
  "excludeTags": [
    "mon",
    "of",
    "player",
    "side",
    "slot",
    "position",
    "source",
    "gender",
    "health",
    "level",
    "name",
    "species",
    "stats",
    "stat",
    "exp",
    "atk",
    "def",
    "spa",
    "spd",
    "spe",
    "hp",
    "target",
    "anim",
    "newmove",
    "pick",
    "size",
    "length",
    "id",
    "time",
    "tera",
    "into_position",
    "hit",
    "hits",
    "count",
    "fallen",
    "perish",
    "shakes",
    "sides",
    "spread",
    "turn",
    "on",
    "to",
    "into",
    "with"
  ],
  "injectDimensions": [
    {
      "match": {
        "title": "crit"
      },
      "inject": ["battletype:singles"]
    },
    {
      "match": {
        "title": "supereffective"
      },
      "inject": ["battletype:singles"]
    },
    {
      "match": {
        "title": "resisted"
      },
      "inject": ["battletype:singles"]
    }
  ],
  "collapseDimensions": [
    {
      "match": {
        "title": "abilitystart"
      },
      "collapse": ["ability"]
    },
    {
      "match": {
        "title": "itemstart"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "abilityend"
      },
      "collapse": ["ability"]
    },
    {
      "match": {
        "title": "addvolatile"
      },
      "collapse": ["volatile"]
    },
    {
      "match": {
        "title": "block"
      },
      "collapse": ["ability", "move", "item"]
    },
    {
      "match": {
        "title": "catch"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "catchfailed"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "deductpp"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "didnotlearnmove"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "learnedmove"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "removevolatile"
      },
      "collapse": ["volatile"]
    },
    {
      "match": {
        "title": "restorepp"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "setpp"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "swapsidecondition"
      },
      "collapse": ["move", "condition"]
    },
    {
      "match": {
        "title": "activate",
        "ability": "Forewarn"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "activate",
        "move": "Fling"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "activate",
        "move": "Poltergeist"
      },
      "collapse": ["item"]
    },
    {
      "match": {},
      "collapse": [
        "type",
        "types",
        "battletype",
        "environment",
        "rule",
        "disabledmove",
        "forgot",
        "mimic"
      ]
    },
    {
      "match": {
        "title": "boost"
      },
      "collapse": ["from"]
    },
    {
      "match": {
        "title": "unboost"
      },
      "collapse": ["from"]
    }
  ],
  "alwaysFromEffectLogs": [
    "cant",
    "sethp",
    "boost",
    "invertboosts",
    "copyboosts",
    "unboost",
    "deductpp",
    "restorepp",
    "setpp",
    "clearboosts",
    "clearnegativeboosts",
    "clearpositiveboosts",
    "swap",
    "transform"
  ]
}
