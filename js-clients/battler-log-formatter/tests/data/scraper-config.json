{
  "manualLogs": [
    "addsidecondition|side:0|condition:Condition|from:Effect",
    "removesidecondition|side:0|condition:Condition|from:Effect",
    "addslotcondition|side:0|slot:0|condition:Condition|from:Effect",
    "removeslotcondition|side:0|slot:0|condition:Condition|from:Effect",
    "addpseudoweather|condition:Condition|from:Effect",
    "removepseudoweather|condition:Condition|from:Effect",
    "turnlimit",
    "debug"
  ],
  "excludeTags": [
    "mon",
    "of",
    "player",
    "side",
    "slot",
    "position",
    "source",
    "gender",
    "health",
    "level",
    "name",
    "species",
    "stats",
    "stat",
    "exp",
    "atk",
    "def",
    "spa",
    "spd",
    "spe",
    "hp",
    "target",
    "anim",
    "newmove",
    "pick",
    "size",
    "length",
    "id",
    "time",
    "tera",
    "into_position",
    "hit",
    "hits",
    "count",
    "fallen",
    "perish",
    "sides",
    "spread",
    "turn",
    "on",
    "to",
    "into",
    "with",
    "magnitude",
    "event",
    "error",
    "effect",
    "learned",
    "silent",
    "positions",
    "animate",
    "animate_only",
    "animateonly",
    "notarget",
    "no_target"
  ],
  "alwaysFromEffectLogs": [
    "cant",
    "sethp",
    "boost",
    "invertboosts",
    "copyboosts",
    "unboost",
    "deductpp",
    "restorepp",
    "setpp",
    "clearboosts",
    "clearnegativeboosts",
    "clearpositiveboosts",
    "swap",
    "transform",
    "block"
  ],
  "alwaysNoTagLogs": ["ohko", "waiting", "animatemove", "protectweaken", "copyboosts", "debug"],
  "noTagUnlessFromLogs": ["immune", "move"],
  "prependWildcardTagLogs": ["block"],
  "ignoreKeys": [
    "item|ability:Frisk",
    "sideend|ability:Screen Cleaner",
    "sidestart|ability:Toxic Debris",
    "fail|what:unboost|from:Resist Intimidate Ability Base",
    "fail|what:unboost|from:Prevent Stat Drop Ability Base",
    "ability|condition:Aura Ability Base",
    "fail|what:*|from:Choice Lock",
    "fail|what:*|from:weather:Heavy Rain",
    "fail|what:*|from:weather:Extremely Harsh Sunlight",
    "sideend|condition:Break Protect",
    "sidestart|item:Guard Spec.",
    "prepare|condition:Charge Move Base",
    "sideend|condition:Defog Move Base",
    "sidestart|condition:Side Screen Move Base",
    "sideend|condition:Side Screen Move Base",
    "fail|from:move:Uproar"
  ],
  "allowKeys": [
    "fail|what:unboost|from:ability:Oblivious",
    "fail|what:unboost|from:ability:Own Tempo",
    "fail|what:unboost|from:ability:Clear Body",
    "fail|what:unboost|from:ability:Illuminate",
    "fail|what:unboost|from:ability:Inner Focus",
    "fail|what:unboost|from:ability:Keen Eye",
    "fail|what:unboost|from:ability:Hyper Cutter",
    "fail|what:unboost|from:ability:White Smoke",
    "fail|what:unboost|from:ability:Scrappy",
    "fail|what:unboost|from:ability:Big Pecks",
    "block|ability:*|from:ability:Aroma Veil",
    "fail|what:unboost|from:ability:Flower Veil",
    "block|ability:*|from:ability:Flower Veil",
    "block|ability:*|from:ability:Sweet Veil",
    "fail|what:unboost|from:ability:Full Metal Body",
    "block|ability:*|from:ability:Pastel Veil",
    "fail|what:unboost|from:ability:Guard Dog",
    "fail|what:unboost|from:ability:Mind's Eye",
    "block|move:*|from:Dynamax",
    "fail|from:Choice Lock",
    "item|item:Air Balloon",
    "fail|what:unboost|from:item:Clear Amulet"
  ],
  "rules": [
    {
      "match": {
        "title": "abilitystart"
      },
      "collapse": ["ability"]
    },
    {
      "match": {
        "title": "itemstart"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "abilityend"
      },
      "collapse": ["ability"]
    },
    {
      "match": {
        "title": "addvolatile"
      },
      "strip": ["from"],
      "collapse": ["volatile"]
    },
    {
      "match": {
        "title": "block"
      },
      "collapse": ["ability", "move", "item"]
    },
    {
      "match": {
        "title": "catch"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "catchfailed"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "deductpp"
      },
      "strip": ["by"],
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "didnotlearnmove"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "learnedmove"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "removevolatile"
      },
      "strip": ["from"],
      "collapse": ["volatile"]
    },
    {
      "match": {
        "title": "restorepp"
      },
      "strip": ["by", "from"],
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "setpp"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "swapsidecondition"
      },
      "collapse": ["move", "condition"]
    },
    {
      "match": {
        "title": "activate",
        "ability": "Forewarn"
      },
      "collapse": ["move"]
    },
    {
      "match": {
        "title": "activate",
        "move": "Fling"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "activate",
        "move": "Poltergeist"
      },
      "collapse": ["item"]
    },
    {
      "match": {},
      "collapse": [
        "type",
        "types",
        "battletype",
        "environment",
        "rule",
        "disabledmove",
        "forgot",
        "mimic"
      ]
    },
    {
      "match": {
        "title": "boost"
      },
      "strip": ["from"]
    },
    {
      "match": {
        "title": "unboost"
      },
      "strip": ["from"]
    },
    {
      "match": {
        "title": "fail",
        "what": "unboost"
      },
      "strip": ["boosts"]
    },
    {
      "match": {
        "title": "itemend",
        "from": "*"
      },
      "collapse": ["item"]
    },
    {
      "match": {
        "title": "mega",
        "from": "item:*"
      },
      "strip": ["from"]
    },
    {
      "match": {
        "title": "primal",
        "from": "item:*"
      },
      "strip": ["from"]
    },
    {
      "match": {
        "title": "revive",
        "from": "item:*"
      },
      "collapse": ["from"]
    },
    {
      "match": {
        "title": "crit"
      },
      "inject": ["battletype:singles"]
    },
    {
      "match": {
        "title": "supereffective"
      },
      "inject": ["battletype:singles"]
    },
    {
      "match": {
        "title": "resisted"
      },
      "inject": ["battletype:singles"]
    },
    {
      "match": {
        "title": "curestatus",
        "from": "item:*"
      },
      "strip": ["from"]
    },
    {
      "match": {
        "title": "move"
      },
      "strip": ["zpower", "noanim"]
    },
    {
      "match": {
        "title": "animatemove"
      },
      "strip": ["noanim"]
    },
    {
      "match": {
        "title": "addsidecondition"
      },
      "strip": ["from"],
      "collapse": ["condition"]
    },
    {
      "match": {
        "title": "removesidecondition"
      },
      "strip": ["from"],
      "collapse": ["condition"]
    },
    {
      "match": {
        "title": "addslotcondition"
      },
      "strip": ["from"],
      "collapse": ["condition"]
    },
    {
      "match": {
        "title": "removeslotcondition"
      },
      "strip": ["from"],
      "collapse": ["condition"]
    },
    {
      "match": {
        "title": "addpseudoweather"
      },
      "strip": ["from"],
      "collapse": ["condition"]
    },
    {
      "match": {
        "title": "removepseudoweather"
      },
      "strip": ["from"],
      "collapse": ["condition"]
    }
  ]
}
