{
  "rawLog": "clearboosts|mon:Amoonguss,player-2,1|from:move:Clear Smog|of:Amoonguss,player-1,1",
  "result": {
    "context": {
      "FROM_MOVE": "Clear Smog",
      "MON": {
        "id": "player-2-active-0",
        "noAutoCapitalize": false,
        "text": "{{player}}'s Amoonguss",
      },
      "MON_POSSESSIVE": {
        "id": "player-2-active-0",
        "noAutoCapitalize": false,
        "text": "{{player}}'s Amoonguss's",
      },
      "SOURCE": {
        "id": "player-1-active-0",
        "noAutoCapitalize": false,
        "text": "the opposing Amoonguss",
      },
      "SOURCE_POSSESSIVE": {
        "id": "player-1-active-0",
        "noAutoCapitalize": false,
        "text": "the opposing Amoonguss's",
      },
      "__CAPITALIZED_MON_POSSESSIVE": {
        "id": "player-2-active-0",
        "noAutoCapitalize": false,
        "text": "{{player}}'s Amoonguss's",
      },
    },
    "formatted": {
      "category": "primary",
      "message": "{{player}}'s Amoonguss's stat changes were removed!",
    },
    "key": "clearboosts",
  },
