{
  "name": "battler",
  "private": true,
  "scripts": {
    "build:battler-choice": "npx wasm-pack build --target nodejs --out-dir pkg/node battler-choice/battler-choice-wasm -- --features typescript && npx wasm-pack build --target bundler --out-dir pkg/bundler battler-choice/battler-choice-wasm -- --features typescript && node battler-choice/post-build.mjs",
    "build:battler-state": "npx wasm-pack build --target nodejs --out-dir pkg/node battler-state -- --features typescript && npx wasm-pack build --target bundler --out-dir pkg/bundler battler-state -- --features typescript && node battler-state/post-build.mjs",
    "build:bindings": "node scripts/build-bindings.mjs",
    "build:deps": "npm run build:bindings",
    "build:js-clients": "npm run build --workspace=battler-types --workspace=battler-wamp-client --workspace=battler-service-client --workspace=battler-data-service-client --workspace=battler-client --workspace=battler-multiplayer-service-client --workspace=battler-multiplayer-client --workspace=js-clients-integration-tests",
    "build:web-app-deps": "npm run build --workspace=battler-types --workspace=battler-wamp-client --workspace=battler-service-client --workspace=battler-data-service-client --workspace=battler-client --workspace=battler-multiplayer-service-client --workspace=battler-multiplayer-client --workspace=team-converter --workspace=battler-log-formatter",
    "build:web-app": "npm run build --workspace=battler-web-app",
    "test:battler-state:wasm": "npx wasm-pack test --node battler-state",
    "test:battler-state:js": "npm run --workspace=battler-state-js-tests test",
    "test:team-converter": "npm run test --workspace=team-converter",
    "test:log-formatter": "npm run test --workspace=battler-log-formatter",
    "lint:log-formatter": "npm run lint --workspace=battler-log-formatter",
    "test:web-app": "npm run test --workspace=battler-web-app",
    "lint:web-app": "npm run lint --workspace=battler-web-app",
    "test:js-unit": "npm run test:team-converter && npm run test:log-formatter && npm run test:web-app",
    "lint:js": "npm run lint --workspaces --if-present",
    "test:js-clients": "npm test --workspace=js-clients-integration-tests"
  },
  "workspaces": [
    "battler-choice/battler-choice-wasm/pkg/node",
    "battler-state/pkg/node",
    "js-clients/battler-types",
    "js-clients/team-converter",
    "js-clients/battler-client",
    "js-clients/battler-data-service-client",
    "js-clients/battler-service-client",
    "js-clients/battler-log-formatter",
    "js-clients/battler-multiplayer-service-client",
    "js-clients/battler-multiplayer-client",
    "js-clients/battler-wamp-client",
    "js-clients/battler-web-app",
    "js-clients/integration-tests",
    "battler-state/js-tests",
    "fxlang-ext",
    "wamp-integration-tests"
  ],
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "wasm-pack": "^0.15.0"
  }
}
