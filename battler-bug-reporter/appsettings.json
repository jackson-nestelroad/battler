{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "GlobalPermitLimit": 30,
    "GlobalWindowHours": 1,
    "GlobalConcurrencyLimit": 2,
    "IpPermitLimit": 10,
    "IpWindowHours": 1
  }
}
